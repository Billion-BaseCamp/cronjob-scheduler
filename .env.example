# Staging / VM. Copy to .env. Do not commit secrets.
# One process: calendar crons + optional Playwright poller (not a CronTrigger).
# uvicorn --workers 1, never --reload.

APP_ENV=staging
APP_NAME=BBC Ops Worker
DEBUG=false

DATABASE_URL_ASYNC=postgresql+asyncpg://USER:PASSWORD@bbc-staging-db.cviic8ukca4b.ap-south-1.rds.amazonaws.com:5432/bbc-staging-db
# Do not set DATABASE_URL_SYNC. This process forces sqlite:///:memory: so
# nucleus does not require psycopg2.

# Calendar jobs (Asia/Kolkata)
FINANCIAL_YEAR_JOB_ENABLED=true
# Off so a portal deploy does not fire FY for every client. Midnight cron still runs.
FINANCIAL_YEAR_RUN_ON_STARTUP=false
QUARTER_TRANSITION_JOB_ENABLED=true
BIRTHDAY_EMAIL_JOB_ENABLED=true

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
EMAIL_SENDER=

# Portal poller (same Fernet + DB as tax-engine). Leave false on cron-only hosts.
PORTAL_WORKER_ENABLED=true
DOCUMENT_PASSWORD_ENCRYPTION_KEY=

PORTAL_AUTOMATION_DRY_RUN=false
PORTAL_AUTOMATION_DRY_RUN_INVALID_PASSWORD=false

PORTAL_LOGIN_URL=https://eportal.incometax.gov.in/iec/foservices/#/login
PORTAL_HOME_URL=https://eportal.incometax.gov.in/iec/foservices/#/pre-login/homepage

PLAYWRIGHT_HEADLESS=true
WORKER_POLL_SECONDS=2
# One process (--workers 1). This many Chromes in parallel.
WORKER_CONCURRENCY=2
WORKER_HEARTBEAT_SECONDS=30
MAX_ATTEMPTS=2

S3_BUCKET_NAME=bbc-staging-bucket-s3
S3_REGION=ap-south-1
AWS_REGION=ap-south-1
# Optional. If set, boto3 uses these instead of the instance role.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
